# ============================================
# LUNCH LOOP - Environment Configuration
# ============================================
# INSTRUCTIONS: Copy this file to .env.local and customize
# Command: cp env.sample .env.local
# All settings are optional with sensible defaults


# ============================================
# APPLICATION CONFIGURATION
# ============================================

# Schema Source: Where to load the planner schema from
# Options: "file" (default) | "db" (requires Supabase)
SCHEMA_SOURCE=file

# Config Source: Where to load app configuration from
# Options: "dummy" (default) | "env" | "db" (requires Supabase)
CONFIG_SOURCE=env

# Persistence Mode: Where to store submissions
# Options: "local" (localStorage, default) | "db" (requires Supabase)
PERSISTENCE_MODE=local


# ============================================
# SUPABASE DATABASE (Optional)
# ============================================
# Required if using SCHEMA_SOURCE=db or PERSISTENCE_MODE=db
# Get these from: https://app.supabase.com/project/_/settings/api

# NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key_here
# SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here


# ============================================
# CONTACT INFORMATION
# ============================================

# Contact phone number displayed in footer and emails
CONTACT_PHONE=+8801700000000


# ============================================
# SMTP EMAIL CONFIGURATION (Optional)
# ============================================
# Required for automatic email delivery of results
# If not configured, emails will be gracefully skipped

# --- Gmail Configuration (Recommended) ---
# 1. Enable 2-Factor Authentication on your Google account
# 2. Generate app password: https://myaccount.google.com/apppasswords
# 3. Use the 16-character app password below (not your regular password)

SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=your.email@gmail.com
SMTP_PASS=your_16_char_app_password
SMTP_FROM=your.email@gmail.com
SMTP_SECURE=true

# --- Other SMTP Providers ---
# For non-Gmail SMTP servers, adjust settings accordingly:
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=your_username
# SMTP_PASS=your_password
# SMTP_FROM=noreply@yourdomain.com
# SMTP_SECURE=false

# Note: 
# - Use SMTP_PORT=465 with SMTP_SECURE=true (SSL/TLS)
# - Use SMTP_PORT=587 with SMTP_SECURE=false (STARTTLS)


# ============================================
# N8N WEBHOOK INTEGRATION (Optional)
# ============================================
# For sending submission data to n8n workflows
# Leave blank to disable webhook integration

# N8N_WEBHOOK_URL=https://your-n8n-instance.com/webhook/lunch-loop
# N8N_SHARED_SECRET=your_shared_secret_for_verification


# ============================================
# ADMIN DASHBOARD AUTHENTICATION
# ============================================

# Enable/disable admin authentication
# Options: "true" | "false" (default)
ADMIN_AUTH_ENABLED=false

# Admin credentials (only used if ADMIN_AUTH_ENABLED=true)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change_this_password_in_production


# ============================================
# CONFIGURATION REFERENCE
# ============================================

# Available SCHEMA_SOURCE options:
# - "file": Load from config/plannerSchema.ts (default, no DB needed)
# - "db": Load from Supabase planner_schema table (requires Supabase setup)

# Available CONFIG_SOURCE options:
# - "dummy": Use hardcoded defaults (good for quick start)
# - "env": Load from environment variables (recommended)
# - "db": Load from Supabase config table (requires Supabase setup)

# Available PERSISTENCE_MODE options:
# - "local": Store in browser localStorage (good for testing)
# - "db": Store in Supabase database (production recommended)


# ============================================
# DEPLOYMENT MODES
# ============================================

# --- Local Development (Current Default) ---
# SCHEMA_SOURCE=file
# CONFIG_SOURCE=env
# PERSISTENCE_MODE=local
# No Supabase or SMTP needed

# --- Production with Database ---
# SCHEMA_SOURCE=db
# CONFIG_SOURCE=db
# PERSISTENCE_MODE=db
# Requires: Supabase configuration
# Optional: SMTP for emails

# --- Hybrid Mode ---
# SCHEMA_SOURCE=file
# CONFIG_SOURCE=env
# PERSISTENCE_MODE=db
# Requires: Supabase for storage only
# Optional: SMTP for emails


# ============================================
# QUICK START GUIDE
# ============================================

# 1. Local Testing (No setup needed):
#    - Current configuration works out of the box
#    - Data stored in browser localStorage
#    - Emails will be skipped (gracefully)

# 2. Enable Email Sending:
#    - Uncomment and fill SMTP_* variables above
#    - For Gmail: Generate app password at https://myaccount.google.com/apppasswords
#    - Restart dev server

# 3. Enable Database Storage:
#    - Set up Supabase project
#    - Add Supabase credentials above
#    - Set PERSISTENCE_MODE=db
#    - Run database migrations (see supabase/schema.sql)

# 4. Enable Admin Authentication:
#    - Set ADMIN_AUTH_ENABLED=true
#    - Change ADMIN_USERNAME and ADMIN_PASSWORD
#    - Access dashboard at /dashboard/login


# ============================================
# NOTES & TIPS
# ============================================

# Email Behavior:
# - If SMTP vars missing: email.skipped event logged, user sees results
# - If SMTP fails: email.failed event logged, user sees results
# - Email sending NEVER blocks the user experience

# Security Best Practices:
# - Never commit .env.local to version control (.gitignore protects it)
# - Use strong passwords in production
# - Rotate credentials regularly
# - Use different values for dev/staging/prod environments
# - For Gmail: Use app passwords, not your main password

# Testing SMTP:
# 1. Copy this file: cp env.sample .env.local
# 2. Edit .env.local with your SMTP credentials
# 3. Restart dev server: npm run dev
# 4. Complete wizard and check your email
# 5. Check terminal logs for email delivery status

# Troubleshooting:
# - If emails not sending: Check SMTP credentials and port
# - If Supabase errors: Verify URL and keys are correct
# - If admin login fails: Check ADMIN_USERNAME and ADMIN_PASSWORD
# - Check browser console and terminal logs for detailed errors
